<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h5>Edit your chat: <%= chat._id %></h5>
    <p>This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b></p>

    <form action="/chats/<%= chat._id %>?_method=PUT" method="post">
            <textarea name="msg" rows="5" cols="40" id=""><%= chat.msg %></textarea>
            <br>
            <button>Edit</button>
    </form>
</body>
</html>